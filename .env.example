# Copy these to Vercel Project Settings > Environment Variables.
# Use Production only for the production database. Use a separate Supabase project for Preview.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
BDS_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
